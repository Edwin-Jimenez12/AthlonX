'use client'

import type { CSSProperties, ReactNode } from 'react'
import { useState } from 'react'
import { Check, Copy } from 'lucide-react'
import type { Theme } from '../../lib/mi-perfil'

const darkTokens: Record<string, string> = {
  '--mp-bg': '#07131E',
  '--mp-surface': '#0B1D2C',
  '--mp-raised': '#102536',
  '--mp-line': '#29485D',
  '--mp-text': '#E8EEF3',
  '--mp-muted': '#91A8BA',
  '--mp-lime': '#B4FF45',
  '--mp-lime-soft': '#17290F',
  '--mp-on-lime': '#07131E',
  '--mp-danger': '#FF6B6B',
}

const lightTokens: Record<string, string> = {
  '--mp-bg': '#F3F6F8',
  '--mp-surface': '#FFFFFF',
  '--mp-raised': '#EEF3F6',
  '--mp-line': '#D5E0E8',
  '--mp-text': '#081522',
  '--mp-muted': '#5B7185',
  '--mp-lime': '#4C8500',
  '--mp-lime-soft': '#E9FBD0',
  '--mp-on-lime': '#FFFFFF',
  '--mp-danger': '#C23B3B',
}

export function themeStyle(theme: Theme): CSSProperties {
  return (theme === 'claro' ? lightTokens : darkTokens) as CSSProperties
}

export function Shell({
  theme,
  sectionLabel,
  sections,
  activeSection,
  onSection,
  children,
}: {
  theme: Theme
  sectionLabel: string
  sections: Array<{ id: string; label: string }>
  activeSection: string
  onSection: (id: string) => void
  children: ReactNode
}) {
  return (
    <div style={themeStyle(theme)} className="min-h-screen bg-[var(--mp-bg)] text-[var(--mp-text)] lg:ml-64">
      <header className="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--mp-line)] px-5 py-5 lg:px-10">
        <img src="/MarcaAthlonX/MarcaHorizontal.svg" alt="AthlonX" className="h-8 w-auto" />
        <p className="font-heading text-sm font-bold uppercase tracking-[.2em] text-[var(--mp-muted)]">
          Mi perfil <span className="text-[var(--mp-lime)]">·</span> {sectionLabel}
        </p>
      </header>
      <div className="mx-auto max-w-5xl px-5 py-8 lg:px-10">
        <nav aria-label="Secciones de Mi perfil" className="mb-8 flex flex-wrap gap-2">
          {sections.map((section) => {
            const active = section.id === activeSection
            return (
              <button
                key={section.id}
                type="button"
                onClick={() => onSection(section.id)}
                aria-current={active ? 'page' : undefined}
                className={`cursor-pointer rounded-[5px] border px-4 py-2 font-heading text-sm font-bold uppercase tracking-wider transition ${active ? 'border-[var(--mp-lime)] bg-[var(--mp-lime)] text-[var(--mp-on-lime)]' : 'border-[var(--mp-line)] bg-[var(--mp-surface)] text-[var(--mp-muted)] hover:text-[var(--mp-text)]'}`}
              >
                {section.label}
              </button>
            )
          })}
        </nav>
        {children}
      </div>
    </div>
  )
}

export function Hero({
  initials,
  title,
  subtitle,
  percent,
  chips,
}: {
  initials: string
  title: string
  subtitle: string
  percent: number
  chips?: ReactNode
}) {
  const complete = percent >= 100
  return (
    <section className="rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-surface)] p-6 lg:p-8">
      <div className="flex flex-col gap-6 sm:flex-row sm:items-center">
        <div className="flex h-24 w-24 shrink-0 items-center justify-center rounded-full border border-[var(--mp-line)] bg-[var(--mp-raised)] font-heading text-3xl font-black text-[var(--mp-lime)]">
          {initials || 'AX'}
        </div>
        <div className="min-w-0 flex-1">
          <h1 className="font-heading text-3xl font-black uppercase leading-tight lg:text-4xl">{title}</h1>
          <p className="mt-2 text-[var(--mp-muted)]">{subtitle}</p>
          {chips && <div className="mt-4 flex flex-wrap gap-2">{chips}</div>}
        </div>
      </div>
      <div className="mt-6">
        <div className="flex items-center justify-between gap-3 text-sm">
          <span className="font-heading font-bold uppercase tracking-wider text-[var(--mp-muted)]">Perfil completo</span>
          <span className="flex items-center gap-2">
            {complete && <span className="rounded-[5px] bg-[var(--mp-lime-soft)] px-2 py-0.5 text-xs font-bold uppercase text-[var(--mp-lime)]">Completo</span>}
            <span className="font-bold">{percent}%</span>
          </span>
        </div>
        <div className="mt-2 h-2 overflow-hidden rounded-full bg-[var(--mp-raised)]" role="progressbar" aria-valuenow={percent} aria-valuemin={0} aria-valuemax={100}>
          <div className="h-full rounded-full bg-[var(--mp-lime)] transition-all" style={{ width: `${percent}%` }} />
        </div>
      </div>
    </section>
  )
}

export function Card({ title, description, children, action }: { title: string; description?: string; children: ReactNode; action?: ReactNode }) {
  return (
    <section className="mt-6 rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-surface)] p-6 lg:p-8">
      <div className="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 className="font-heading text-xl font-black uppercase tracking-wide">{title}</h2>
          {description && <p className="mt-1 text-sm text-[var(--mp-muted)]">{description}</p>}
        </div>
        {action}
      </div>
      <div className="mt-6">{children}</div>
    </section>
  )
}

export function Field({
  label,
  value,
  onChange,
  disabled = false,
  type = 'text',
  maxLength,
  hint,
  placeholder,
  as = 'input',
}: {
  label: string
  value: string
  onChange?: (value: string) => void
  disabled?: boolean
  type?: string
  maxLength?: number
  hint?: string
  placeholder?: string
  as?: 'input' | 'textarea'
}) {
  const classes = 'mt-2 w-full rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-raised)] px-4 py-3 text-[var(--mp-text)] outline-none focus:border-[var(--mp-lime)] disabled:opacity-60'
  return (
    <label className="block">
      <span className="font-heading text-xs font-bold uppercase tracking-[.16em] text-[var(--mp-muted)]">{label}</span>
      {as === 'textarea' ? (
        <textarea className={`${classes} min-h-32 resize-y`} value={value} disabled={disabled} maxLength={maxLength} placeholder={placeholder} onChange={(event) => onChange?.(event.target.value)} />
      ) : (
        <input className={classes} type={type} value={value} disabled={disabled} maxLength={maxLength} placeholder={placeholder} onChange={(event) => onChange?.(event.target.value)} />
      )}
      <span className="mt-1 flex justify-between gap-3 text-xs text-[var(--mp-muted)]">
        <span>{hint}</span>
        {maxLength && <span>{value.length}/{maxLength}</span>}
      </span>
    </label>
  )
}

export function ReadValue({ label, value, copyable = false }: { label: string; value: string; copyable?: boolean }) {
  const [copied, setCopied] = useState(false)
  async function copy() {
    if (!value) return
    try {
      await navigator.clipboard.writeText(value)
      setCopied(true)
      window.setTimeout(() => setCopied(false), 1500)
    } catch {
      setCopied(false)
    }
  }
  return (
    <div>
      <span className="font-heading text-xs font-bold uppercase tracking-[.16em] text-[var(--mp-muted)]">{label}</span>
      <div className="mt-2 flex items-center justify-between gap-3 rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-raised)] px-4 py-3">
        <span className="min-w-0 truncate font-semibold">{value || 'Pendiente'}</span>
        {copyable && value && (
          <button type="button" onClick={copy} aria-label={copied ? 'Código copiado' : 'Copiar código'} title={copied ? 'Copiado' : 'Copiar código'} className="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-[5px] text-[var(--mp-lime)] hover:bg-[var(--mp-lime-soft)]">
            {copied ? <Check size={18} /> : <Copy size={18} />}
          </button>
        )}
      </div>
    </div>
  )
}

export function Toggle({ label, description, checked, onChange, disabled = false }: { label: string; description?: string; checked: boolean; onChange: (value: boolean) => void; disabled?: boolean }) {
  return (
    <label className="flex cursor-pointer items-center justify-between gap-4 rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-raised)] px-4 py-3">
      <span>
        <span className="block font-semibold">{label}</span>
        {description && <span className="block text-xs text-[var(--mp-muted)]">{description}</span>}
      </span>
      <input type="checkbox" className="peer sr-only" checked={checked} disabled={disabled} onChange={(event) => onChange(event.target.checked)} />
      <span className={`relative h-6 w-11 shrink-0 rounded-full transition ${checked ? 'bg-[var(--mp-lime)]' : 'bg-[var(--mp-line)]'} ${disabled ? 'opacity-60' : ''}`}>
        <span className={`absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition ${checked ? 'left-[22px]' : 'left-0.5'}`} />
      </span>
    </label>
  )
}

export function Segmented<T extends string>({ options, value, onChange, disabled = false }: { options: Array<{ value: T; label: string }>; value: T; onChange: (value: T) => void; disabled?: boolean }) {
  return (
    <div role="radiogroup" className="inline-flex flex-wrap gap-1 rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-raised)] p-1">
      {options.map((option) => {
        const active = option.value === value
        return (
          <button key={option.value} type="button" role="radio" aria-checked={active} disabled={disabled} onClick={() => onChange(option.value)} className={`cursor-pointer rounded-[4px] px-4 py-2 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-60 ${active ? 'bg-[var(--mp-lime)] text-[var(--mp-on-lime)]' : 'text-[var(--mp-muted)]'}`}>
            {option.label}
          </button>
        )
      })}
    </div>
  )
}

export function Chip({ children, tone = 'default' }: { children: ReactNode; tone?: 'default' | 'lime' }) {
  return <span className={`inline-flex items-center rounded-[5px] px-3 py-1.5 text-xs font-bold uppercase tracking-wider ${tone === 'lime' ? 'bg-[var(--mp-lime-soft)] text-[var(--mp-lime)]' : 'bg-[var(--mp-raised)] text-[var(--mp-muted)]'}`}>{children}</span>
}

export function ListRow({ title, meta, right }: { title: string; meta?: string; right?: ReactNode }) {
  return (
    <div className="flex flex-wrap items-center justify-between gap-3 rounded-[5px] border border-[var(--mp-line)] bg-[var(--mp-raised)] px-4 py-3">
      <div className="min-w-0">
        <p className="truncate font-semibold">{title}</p>
        {meta && <p className="text-xs text-[var(--mp-muted)]">{meta}</p>}
      </div>
      {right}
    </div>
  )
}

export function SaveBar({ onSave, saving, disabled, message, error }: { onSave: () => void; saving: boolean; disabled?: boolean; message?: string; error?: string }) {
  return (
    <div className="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--mp-line)] pt-5">
      <p className={`text-sm ${error ? 'text-[var(--mp-danger)]' : 'text-[var(--mp-muted)]'}`}>{error || message || ''}</p>
      <button type="button" onClick={onSave} disabled={saving || disabled} className="cursor-pointer rounded-[5px] bg-[var(--mp-lime)] px-6 py-3 font-heading text-sm font-black uppercase tracking-wider text-[var(--mp-on-lime)] disabled:cursor-not-allowed disabled:opacity-50">
        {saving ? 'Guardando…' : 'Guardar cambios'}
      </button>
    </div>
  )
}

export function Pending({ children }: { children: ReactNode }) {
  return <p className="rounded-[5px] border border-dashed border-[var(--mp-line)] px-4 py-3 text-sm text-[var(--mp-muted)]">{children}</p>
}
