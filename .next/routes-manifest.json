      "page": "/dashboard/torneos/[torneo]",
      "regex": "^/dashboard/torneos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtorneo": "nxtPtorneo"
      },
      "namedRegex": "^/dashboard/torneos/(?<nxtPtorneo>[^/]+?)(?:/)?$"
    }
  ],
